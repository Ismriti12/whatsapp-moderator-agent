# ---- Secrets / API keys ----
GEMINI_API_KEY=your-gemini-api-key-here

# ---- Database ----
# Default: local SQLite file, zero setup required.
# To use Postgres instead, uncomment and edit the line below.
DATABASE_URL=sqlite:///data/whatsapp.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/whatsapp_moderator

# ---- WhatsApp listener ----
# Exact name of the WhatsApp group/chat to monitor (as shown in the chat list).
WHATSAPP_TARGET_CHAT=My Group Name
# How often (seconds) the listener polls the chat for new messages.
WHATSAPP_POLL_INTERVAL=5
# Run the browser headless after the first QR login (set to false to always show it).
WHATSAPP_HEADLESS=false

# ---- Moderation engine ----
# Comma separated categories the model should flag as unsafe.
MODERATION_FLAG_CATEGORIES=spam,harassment,hate_speech,explicit_content,scam

# ---- API server ----
API_HOST=0.0.0.0
API_PORT=8000
