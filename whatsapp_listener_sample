"""WhatsApp Web listener built on Playwright.

Opens WhatsApp Web in a persistent browser profile (stored under
data/playwright-profile) so the QR code only needs to be scanned once per
machine. Polls a target chat for new messages and forwards each one to the
moderation engine.

Note: WhatsApp Web's DOM/selectors change periodically. The selectors below
are a best-effort as of 2024/2025; if message detection stops working, the
`MESSAGE_ROW_SELECTOR_CANDIDATES` / `CHAT_PANEL_SELECTOR` constants are the
first place to update.
"""
from __future__ import annotations

import logging
import os
import time
from pathlib import Path

from dotenv import load_dotenv
from playwright.sync_api import Page, sync_playwright

from app.moderation_engine import IncomingMessage, process_message

load_dotenv()

logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
logger = logging.getLogger(__name__)

PROFILE_DIR = Path(__file__).resolve().parent.parent / "data" / "playwright-profile"
PROFILE_DIR.mkdir(parents=True, exist_ok=True)

TARGET_CHAT = os.getenv("WHATSAPP_TARGET_CHAT", "")
POLL_INTERVAL = float(os.getenv("WHATSAPP_POLL_INTERVAL", "5"))
HEADLESS = os.getenv("WHATSAPP_HEADLESS", "false").strip().lower() == "true"

WHATSAPP_URL = "https://web.whatsapp.com"
CHAT_SEARCH_SELECTOR = 'div[contenteditable="true"][data-tab="3"]'
MESSAGE_COMPOSE_SELECTOR = 'div[contenteditable="true"][data-tab="10"]'
CHAT_PANEL_SELECTOR = "#main"
# WhatsApp Web's internal class names change often; try the modern selector
# first and fall back to the attribute every message row has always had.
MESSAGE_ROW_SELECTOR_CANDIDATES = [
    "div.message-in, div.message-out",
    "div[data-id]",
]
MESSAGE_TEXT_SELECTOR = "span.selectable-text"
SENDER_NAME_SELECTOR = "span[aria-label]._ao3e, span[dir='auto']"

_seen_message_ids: set[str] = set()
_last_row_count_logged: int | None = None


def _open_target_chat(page: Page, chat_name: str) -> None:
    """Wait for the user to manually open the configured chat.

    WhatsApp Web's search-box selector changes often enough across versions
    that automating "find and click the chat" is unreliable. Instead, the
    user is asked to open the chat themselves (search box or chat list,
    whichever works on their WhatsApp Web version); this function polls for
    a real message compose box to appear (which only happens once a chat is
    open), logging a heartbeat periodically so it's clear the script is
    still alive and waiting.
    """
    logger.info(
        "ACTION NEEDED: In the browser window, please manually open the chat "
        "'%s' (use the search box or click it in the chat list).",
        chat_name,
    )

    max_wait_seconds = 180
    poll_seconds = 2
    heartbeat_every_seconds = 15
    elapsed = 0

    while elapsed < max_wait_seconds:
        if page.locator(MESSAGE_COMPOSE_SELECTOR).count() > 0:
            page.wait_for_timeout(1000)
            logger.info("Chat is open. Listening will begin now.")
            return
        if elapsed % heartbeat_every_seconds == 0:
            logger.info(
                "Still waiting for the chat to be opened... (%ss elapsed, timeout at %ss)",
                elapsed,
                max_wait_seconds,
            )
        page.wait_for_timeout(poll_seconds * 1000)
        elapsed += poll_seconds

    raise TimeoutError(
        f"Timed out after {max_wait_seconds}s waiting for chat '{chat_name}' to be opened. "
        "Make sure you clicked into the chat so the message box at the bottom is visible."
    )


def _extract_new_messages(page: Page, chat_name: str) -> list[IncomingMessage]:
    """Read currently rendered message bubbles and return ones not seen yet."""
    global _last_row_count_logged

    panel = page.locator(CHAT_PANEL_SELECTOR)

    rows = None
    count = 0
    for selector in MESSAGE_ROW_SELECTOR_CANDIDATES:
        candidate = panel.locator(selector)
        candidate_count = candidate.count()
        if candidate_count > 0:
            rows = candidate
            count = candidate_count
            break

    if rows is None:
        if _last_row_count_logged != 0:
            logger.warning(
                "No message rows found in the chat panel. Make sure the chat "
                "is open and visible in the browser window."
            )
            _last_row_count_logged = 0
        return []

    if count != _last_row_count_logged:
        logger.info("Scanning chat: %d message row(s) currently visible", count)
        _last_row_count_logged = count

    new_messages: list[IncomingMessage] = []

    # Only look at the tail of the conversation; full history isn't needed.
    start = max(0, count - 30)
    for i in range(start, count):
        row = rows.nth(i)

        try:
            text_nodes = row.locator(MESSAGE_TEXT_SELECTOR)
            text = " ".join(
                text_nodes.nth(j).inner_text() for j in range(text_nodes.count())
            ).strip()
            if not text:
                # Fall back to the row's full visible text if the specific
                # text-span selector doesn't match (UI changed).
                text = row.inner_text().strip()
        except Exception:  # noqa: BLE001
            continue

        if not text:
            continue

        row_id = row.get_attribute("data-id") or f"{chat_name}:{i}:{text[:50]}"
        if row_id in _seen_message_ids:
            continue

        sender = None
        try:
            sender_locator = row.locator(SENDER_NAME_SELECTOR).first
            if sender_locator.count() > 0:
                sender = sender_locator.get_attribute("aria-label") or sender_locator.inner_text()
        except Exception:  # noqa: BLE001
            sender = None

        _seen_message_ids.add(row_id)
        new_messages.append(IncomingMessage(chat_name=chat_name, sender=sender, text=text))

    return new_messages


def run_listener(chat_name: str | None = None, poll_interval: float | None = None) -> None:
    """Start the blocking listener loop. Intended to run in its own thread/process."""
    chat_name = chat_name or TARGET_CHAT
    poll_interval = poll_interval or POLL_INTERVAL

    if not chat_name:
        raise ValueError(
            "No target chat configured. Set WHATSAPP_TARGET_CHAT in .env or pass chat_name=."
        )

    logger.info("Starting WhatsApp listener for chat '%s'", chat_name)
    logger.info("Launching browser (first launch can take a few seconds)...")

    with sync_playwright() as pw:
        context = pw.chromium.launch_persistent_context(
            user_data_dir=str(PROFILE_DIR),
            headless=HEADLESS,
        )
        logger.info("Browser launched. Opening WhatsApp Web...")
        page = context.pages[0] if context.pages else context.new_page()
        page.goto(WHATSAPP_URL)
        logger.info("Page loaded. If a QR code is shown, scan it with your phone now.")

        _open_target_chat(page, chat_name)
        logger.info("Listening for new messages in '%s' every %ss", chat_name, poll_interval)

        try:
            while True:
                try:
                    for msg in _extract_new_messages(page, chat_name):
                        process_message(msg)
                except Exception:  # noqa: BLE001
                    logger.exception("Error while polling for messages; will retry")
                time.sleep(poll_interval)
        except KeyboardInterrupt:
            logger.info("Listener stopped by user")
        finally:
            context.close()


if __name__ == "__main__":
    run_listener()
